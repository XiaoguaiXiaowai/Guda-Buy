# GUDA 生产环境变量（部署到 /srv/guda/env/.env，权限 600，属主 guda）

# ---- Django ----
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=请替换为 64 位随机字符串
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=guda.example.com

# ---- Database ----
DB_NAME=guda
DB_USER=guda
DB_PASSWORD=请替换为数据库密码
DB_HOST=127.0.0.1
DB_PORT=3306

# ---- Redis / Celery ----
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ---- JWT ----
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# ---- 模拟支付 ----
PAYMENT_CALLBACK_SECRET=请替换为 32 位随机字符串

# ---- 敏感字段加密 ----
FIELD_ENCRYPTION_KEY=请替换为 32 字节 base64 密钥

# ---- 邮件 ----
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=no-reply@guda.example.com
MAIL_PASSWORD=请替换为邮箱密码

# ---- 业务参数 ----
APP_ORDER_TIMEOUT_MINUTES=30
APP_SITE_URL=https://guda.example.com
