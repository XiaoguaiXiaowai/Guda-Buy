[Unit]
Description=GUDA Celery Beat
After=network.target redis-server.service
Requires=redis-server.service

[Service]
Type=simple
User=guda
Group=guda
WorkingDirectory=/srv/guda/app/backend
EnvironmentFile=/srv/guda/env/.env
ExecStart=/srv/guda/app/backend/.venv/bin/celery -A config beat -l info
Restart=always
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
