# GUDA 后端环境变量示例（复制为 .env 后填写；禁止提交真实密钥）
# 说明见 docs/开发文档.md 11.1

# ---- Django ----
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-random-64-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ---- Database (MariaDB / MySQL 兼容) ----
DB_NAME=guda_dev
DB_USER=guda_app
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# ---- Redis / Celery（DB 划分见架构文档 3.6） ----
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ---- JWT ----
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# ---- 模拟支付 ----
PAYMENT_CALLBACK_SECRET=change-me-to-a-random-32-char-string

# ---- 敏感字段加密（32 字节 base64） ----
FIELD_ENCRYPTION_KEY=change-me-32-bytes-base64-key

# ---- 邮件 ----
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=no-reply@guda.example.com
MAIL_PASSWORD=change-me

# ---- 业务开关 ----
APP_ORDER_TIMEOUT_MINUTES=30
APP_SITE_URL=http://localhost:5173

# ---- 开发环境跨域（生产不配置） ----
CORS_ALLOWED_ORIGINS=http://localhost:5173
